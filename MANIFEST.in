include README.md
include ИНСТРУКЦИЯ.md
include MANIFEST.in
recursive-include windows/legacy *
graft src/pcmcia_flash
graft src/pcmcia_kit
graft tests

# Кэш Python в архив выпуска попадать не должен: он появляется от любого
# локального запуска и к набору отношения не имеет (раньше в sdist уезжало
# 127 файлов *.pyc).
global-exclude __pycache__ *.pyc *.pyo
